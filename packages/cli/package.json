{
  "name": "@rjantoine/open-poll-slide-cli",
  "version": "0.1.0",
  "description": "Scaffold an open-poll-slide workspace (a fork of open-slide with live polling sessions) with agent skills preconfigured.",
  "type": "module",
  "bin": {
    "open-poll-slide-cli": "dist/cli.js"
  },
  "files": [
    "dist",
    "template",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/sync-template-skills.mjs && tsdown",
    "typecheck": "tsc --noEmit",
    "sync:template-skills": "node scripts/sync-template-skills.mjs",
    "prepack": "pnpm build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "keywords": [
    "slides",
    "presentation",
    "claude-code",
    "scaffold"
  ],
  "license": "MIT",
  "author": {
    "name": "rjantoine",
    "url": "https://github.com/m-rantoine"
  },
  "homepage": "https://github.com/m-rantoine/open-poll-slide#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/m-rantoine/open-poll-slide.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/m-rantoine/open-poll-slide/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}

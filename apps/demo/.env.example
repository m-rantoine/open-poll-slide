SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<publishable key>
# Optional, comma separated; display only (enforced by the database):
# OPEN_SLIDE_ALLOWED_EMAIL_DOMAINS=school.example
# Tells sites that share one database apart, for example one per course (see LIVE-SESSIONS.md):
# OPEN_SLIDE_SITE_LABEL=bio-11
# Decks are public unless this is true or a deck exports `isPrivate`. The demo sets it to true in
# .env.production, so built sites hide decks from non-hosts.
# SLIDES_DEFAULT_AS_PRIVATE=true
